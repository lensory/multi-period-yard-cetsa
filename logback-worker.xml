<configuration>
    <!-- File: one run log per MDC runOutputDir. Worker stdout is reserved for direct System.out fallback. -->
    <appender name="RUN_FILE" class="ch.qos.logback.classic.sift.SiftingAppender">
        <discriminator>
            <key>runOutputDir</key>
            <defaultValue>output/run</defaultValue>
        </discriminator>
        <sift>
            <appender name="FILE-${runOutputDir}" class="ch.qos.logback.core.rolling.RollingFileAppender">
                <file>${runOutputDir}/experiment.log</file>
                <encoder>
                    <pattern>%d{yyyy-MM-dd HH:mm:ss.SSS} %-5level [%thread] %-45logger - %msg%n</pattern>
                </encoder>
                <rollingPolicy class="ch.qos.logback.core.rolling.SizeAndTimeBasedRollingPolicy">
                    <fileNamePattern>${runOutputDir}/experiment.%d{yyyy-MM-dd}.%i.log.gz</fileNamePattern>
                    <maxFileSize>256MB</maxFileSize>
                    <maxHistory>7</maxHistory>
                    <totalSizeCap>2GB</totalSizeCap>
                </rollingPolicy>
            </appender>
        </sift>
    </appender>

    <logger name="ilog" level="WARN"/>
    <logger name="org" level="WARN"/>

    <root level="INFO">
        <appender-ref ref="RUN_FILE"/>
    </root>
</configuration>
