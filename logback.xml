<configuration>
    <!-- Console: colorful and compact -->
    <appender name="CONSOLE" class="ch.qos.logback.core.ConsoleAppender">
        <encoder>
            <pattern>%d{HH:mm:ss.SSS} %highlight(%-5level) [%thread] %cyan(%-45logger) %msg%n</pattern>
        </encoder>
    </appender>

    <!-- File: one run log per MDC runOutputDir -->
    <appender name="RUN_FILE" class="ch.qos.logback.classic.sift.SiftingAppender">
        <discriminator>
            <key>runOutputDir</key>
            <defaultValue>output/run</defaultValue>
        </discriminator>
        <sift>
            <appender name="FILE-${runOutputDir}" class="ch.qos.logback.core.FileAppender">
                <file>${runOutputDir}/experiment.log</file>
                <append>true</append>
                <encoder>
                    <pattern>%d{yyyy-MM-dd HH:mm:ss.SSS} %-5level [%thread] %-45logger - %msg%n</pattern>
                </encoder>
            </appender>
        </sift>
    </appender>

    <logger name="ilog" level="WARN"/>
    <logger name="org" level="WARN"/>

    <logger name="main.Main" level="INFO" additivity="false">
        <appender-ref ref="CONSOLE"/>
    </logger>

    <root level="INFO">
        <appender-ref ref="CONSOLE"/>
        <appender-ref ref="RUN_FILE"/>
    </root>
</configuration>
